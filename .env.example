# NexWatch – Environment variables
# Copy this file to .env and fill in your values.
# ⚠️  Never commit .env to git — it's already in .gitignore.

# ── Password protection ───────────────────────────────────
# Leave empty to disable the lock screen (no password required).
# Set any string here to require it on first visit.
# The session persists in localStorage — users won't be re-asked on reload.
VITE_APP_PASSWORD=

# ── TMDB (movies & TV shows) ─────────────────────────────
# Free API key from: https://www.themoviedb.org/settings/api
VITE_TMDB_KEY=your_tmdb_api_key_here

# ── Turso (cloud SQLite — cross-device sync) ─────────────
# Free database at: https://turso.tech/
# After creating a DB, run:  turso db show --url <db-name>
#                            turso db tokens create <db-name>
VITE_TURSO_URL=libsql://your-db-name.turso.io
VITE_TURSO_TOKEN=your_turso_auth_token_here
